<?xml version="1.0"?>
<robot name="kaair" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!--
    arm_hw.urdf.xacro
    ─────────────────────────────────────────────────────────────────────
    arm_controller_manager 전용 robot_description.
    arm 의 <ros2_control> 블록만 포함한다.

    · use_fake_hardware=false → UFRobotSystemHardware  (실제 xArm7)
    · use_fake_hardware=true  → arm.ros2_control.xacro / mock_components/GenericSystem
                                 initial_positions_file 로 초기 자세 설정 가능

    body_controller_manager / robot_state_publisher 에는 사용하지 않는다.
    RSP 는 kaair.urdf.xacro (mode=robot) 전체 URDF 를 사용한다.
  -->
  <xacro:arg name="use_fake_hardware"      default="false"/>
  <xacro:arg name="hw_spec_file"
             default="$(find kaair_bringup)/config/robots/kaair_specs_01.yaml"/>
  <xacro:arg name="initial_positions_file"
             default="$(find kaair_moveit_config)/config/initial_positions.yaml"/>

  <!-- URDF 유효성을 위한 최소 루트 링크 -->
  <link name="arm_hw_base"/>

  <!-- ── 실제 하드웨어 ──────────────────────────────────────────────────── -->
  <xacro:unless value="$(arg use_fake_hardware)">
    <xacro:property name="hw_specs" value="${xacro.load_yaml('$(arg hw_spec_file)')}"/>

    <xacro:include filename="$(find xarm_description)/urdf/xarm_device_macro.xacro"/>
    <xacro:xarm_device
      prefix=""
      hw_ns="xarm"
      dof="7"
      add_gripper="false"
      attach_to="arm_hw_base"
      effort_control="false"
      velocity_control="false"
      limited="true"
      robot_ip="${hw_specs['arm']['robot_ip']}"
      ros2_control_plugin="uf_robot_hardware/UFRobotSystemHardware"
    />
  </xacro:unless>

  <!-- ── 가짜 하드웨어 (MoveIt fake mode) ──────────────────────────────── -->
  <!--
    xarm_device_macro 는 initial_positions_file 을 지원하지 않으므로
    (UFRobotFakeSystemHardware = GenericSystem without initial_value),
    arm.ros2_control.xacro 에서 직접 GenericSystem 블록을 정의하고
    initial_value 를 삽입한다.

    real 모드(xacro:xarm_device)는 xarm7_robot_macro.xacro 를 통해
    joint1~7 의 실제 kinematic <joint> 를 함께 생성하지만, 이 fake 블록은
    <ros2_control> 인터페이스만 정의한다. ros2_control >= 4.x (Jazzy~) 의
    hardware_interface 는 <ros2_control> 이 참조하는 각 joint 가 URDF
    kinematic 트리에도 존재할 것을 요구하므로("Joint 'X' not found in
    URDF" 로 초기화 실패), 아래 최소 kinematic stub 체인을 함께 둔다.
    (Humble/ros2_control 2.x 는 이 검증이 없어 stub 없이도 동작했었다.)
  -->
  <xacro:if value="$(arg use_fake_hardware)">
    <xacro:include
      filename="$(find kaair_moveit_config)/config/arm.ros2_control.xacro"/>
    <xacro:arm_ros2_control
      name="ArmFakeSystem"
      initial_positions_file="$(arg initial_positions_file)"/>

    <link name="arm_hw_stub_link1"/>
    <link name="arm_hw_stub_link2"/>
    <link name="arm_hw_stub_link3"/>
    <link name="arm_hw_stub_link4"/>
    <link name="arm_hw_stub_link5"/>
    <link name="arm_hw_stub_link6"/>
    <link name="arm_hw_stub_link7"/>

    <joint name="joint1" type="revolute">
      <parent link="arm_hw_base"/>
      <child link="arm_hw_stub_link1"/>
      <axis xyz="0 0 1"/>
      <limit lower="${-pi*0.99}" upper="${pi*0.99}" effort="50" velocity="3.14"/>
    </joint>
    <joint name="joint2" type="revolute">
      <parent link="arm_hw_stub_link1"/>
      <child link="arm_hw_stub_link2"/>
      <axis xyz="0 0 1"/>
      <limit lower="-2.18" upper="2.18" effort="50" velocity="3.14"/>
    </joint>
    <joint name="joint3" type="revolute">
      <parent link="arm_hw_stub_link2"/>
      <child link="arm_hw_stub_link3"/>
      <axis xyz="0 0 1"/>
      <limit lower="${-pi*0.99}" upper="${pi*0.99}" effort="30" velocity="3.14"/>
    </joint>
    <joint name="joint4" type="revolute">
      <parent link="arm_hw_stub_link3"/>
      <child link="arm_hw_stub_link4"/>
      <axis xyz="0 0 1"/>
      <limit lower="-0.11" upper="${pi*0.99}" effort="30" velocity="3.14"/>
    </joint>
    <joint name="joint5" type="revolute">
      <parent link="arm_hw_stub_link4"/>
      <child link="arm_hw_stub_link5"/>
      <axis xyz="0 0 1"/>
      <limit lower="${-pi*0.99}" upper="${pi*0.99}" effort="20" velocity="3.14"/>
    </joint>
    <joint name="joint6" type="revolute">
      <parent link="arm_hw_stub_link5"/>
      <child link="arm_hw_stub_link6"/>
      <axis xyz="0 0 1"/>
      <limit lower="-1.75" upper="${pi*0.99}" effort="20" velocity="3.14"/>
    </joint>
    <joint name="joint7" type="revolute">
      <parent link="arm_hw_stub_link6"/>
      <child link="arm_hw_stub_link7"/>
      <axis xyz="0 0 1"/>
      <limit lower="${-pi*0.99}" upper="${pi*0.99}" effort="20" velocity="3.14"/>
    </joint>
  </xacro:if>

</robot>
