<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>kaair_bringup</name>
  <version>0.0.0</version>
  <description>TODO: Package description</description>
  <maintainer email="ferglie@naver.com">smi</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>image_transport</depend>
  <!-- depth_hole_fill_node의 median hole-filling 처리에 사용 -->
  <depend>cv_bridge</depend>
  <depend>libopencv-dev</depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <!-- depth_pointcloud_publisher: depth 이미지를 PointCloud2로 변환/발행 -->
  <exec_depend>sensor_msgs_py</exec_depend>

  <!-- image_transport 런타임 플러그인: depth_hole_filler 노드가 사용 -->
  <exec_depend>compressed_image_transport</exec_depend>

  <exec_depend>control_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>action_msgs</exec_depend>

  <exec_depend>kaair_description</exec_depend>
  <exec_depend>kaair_controller</exec_depend>
  <!-- kaair_moveit_config 는 exec_depend 로 선언하지 않는다: 그 패키지가 이미
       kaair_bringup 에 의존하므로 순환 의존이 되어 colcon 빌드 순서를 정할
       수 없다. kaair_moveit_bringup.launch.py 등에서 servo_module.py 를
       sys.path 로 런타임 import 하는 것은 (kaair_moveit_config 가 이미
       kaair_controller 의 config 를 선언 없이 참조하던 것과 동일하게)
       빌드 그래프에는 실리지 않는 암묵적 런타임 의존이다. -->


  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
