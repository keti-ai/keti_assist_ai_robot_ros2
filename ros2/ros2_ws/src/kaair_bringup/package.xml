<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>kaair_bringup</name>
  <version>0.0.0</version>
  <description>TODO: Package description</description>
  <maintainer email="ferglie@naver.com">smi</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>libopencv-dev</depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <!-- depth_pointcloud_publisher: depth 이미지를 PointCloud2로 변환/발행 -->
  <exec_depend>sensor_msgs_py</exec_depend>

  <exec_depend>compressed_image_transport</exec_depend>

  <exec_depend>control_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>action_msgs</exec_depend>

  <!-- server_worker_loader.py: ufactory_driver(xarm_driver_node) 실행 및
       generate_robot_api_params 로 config/common/kaair_xarm7_param.yaml 적용 -->
  <exec_depend>xarm_api</exec_depend>
  <exec_depend>uf_ros_lib</exec_depend>
  <!-- xarm_bridge.py: /arm/init_set 이 드라이버 서비스를 호출할 때 쓰는 srv 타입 -->
  <exec_depend>xarm_msgs</exec_depend>

  <!-- eef_state_publisher.py: robot_description 을 파싱해 KDL 체인/야코비안 구성 -->
  <exec_depend>urdfdom_py</exec_depend>
  <exec_depend>python_orocos_kdl_vendor</exec_depend>

  <exec_depend>kaair_description</exec_depend>
  <exec_depend>kaair_controller</exec_depend>
  <exec_depend>kaair_mobile_bridge</exec_depend>
  <!-- text_status_overlay.py: String 을 RViz 화면 고정 텍스트 오버레이로 표시 -->
  <exec_depend>rviz_2d_overlay_msgs</exec_depend>


  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
